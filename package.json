{
  "name": "opencode-qoder-provider",
  "version": "0.2.0",
  "description": "Qoder AI provider for OpenCode — based on @qoder-ai/qoder-agent-sdk",
  "author": "wcmk21",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wcmk21/opencode-qoder-provider.git"
  },
  "homepage": "https://github.com/wcmk21/opencode-qoder-provider#readme",
  "bugs": {
    "url": "https://github.com/wcmk21/opencode-qoder-provider/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "qoder",
    "ai",
    "provider",
    "agent-sdk"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugin": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    },
    "./plugin-v2": {
      "import": "./dist/plugin-v2.js",
      "types": "./dist/plugin-v2.d.ts"
    },
    "./server": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "esbuild src/index.ts src/plugin.ts src/plugin-v2.ts --bundle --platform=node --format=esm --outdir=dist --external:@qoder-ai/qoder-agent-sdk --external:@ai-sdk/provider --external:@opencode-ai/plugin --external:zod",
    "build:types": "tsc --emitDeclarationOnly",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm run build && npm run test"
  },
  "dependencies": {
    "@qoder-ai/qoder-agent-sdk": "^1.0.25",
    "@qoder-ai/qodercli": "^1.1.31",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^3.0.8"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@opencode-ai/plugin": "^1.18.23",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
